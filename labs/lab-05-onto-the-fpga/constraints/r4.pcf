# r4.pcf — "put this signal on that physical pin."
# These 14 pins are valid on an iCE40 UP5K in the SG48 package. They are NOT
# wired to anything in particular on any board; this file exists to show you
# what the mechanism looks like, not to light an LED.
set_io a[0]    2
set_io a[1]    3
set_io a[2]    4
set_io a[3]    6
set_io b[0]    9
set_io b[1]   10
set_io b[2]   11
set_io b[3]   12
set_io cin    13
set_io sum[0] 14
set_io sum[1] 15
set_io sum[2] 16
set_io sum[3] 17
set_io cout   18
